<Flavors>

    <!-- Default OMCW state, only one page works in this flavor -->
    <Flavor Name="Default">
        <Page Name="Blank" Duration="1" TopSolid="0" BottomSolid="0" LDL="DateTime" RegionSeparator="0"/>
    </Flavor>

    <!-- Flavor L 2:00 source: https://www.youtube.com/watch?v=2GW9zbc0WDg -->
    <Flavor Name="L">
        <Page Name="CurrentConditions" Duration="12"/>
        <Page Name="LatestObservations" Duration="12"/>
        <Page Name="RegionalObservations" Duration="12"/>
        <!-- Switch LDL to ad crawl -->
        <Page Name="RegionalForecast" Duration="12" LDL="LocalCrawl"/>
        <Page Name="Almanac" Duration="12"/>
        <Page Name="Forecast1" Duration="12"/>
        <Page Name="Forecast2" Duration="12"/>
        <!-- Switch LDL back to normal -->
        <Page Name="Forecast3" Duration="12" LDL="DateTime"/>
        <Page Name="ExtendedForecast" Duration="24"/>
    </Flavor>

    <!-- Flavor M 2:00 source: https://www.youtube.com/watch?v=jMwOs-JVc4Y -->
    <Flavor Name="M">
        <Page Name="CurrentConditions" Duration="12"/>
        <!-- Switch LDL to ad crawl -->
        <Page Name="Forecast1" Duration="12" LDL="LocalCrawl"/>
        <Page Name="Forecast2" Duration="12"/>
        <Page Name="Forecast3" Duration="12"/>
        <!-- Switch LDL back to normal -->
        <Page Name="ExtendedForecast" Duration="24" LDL="DateTime"/>
        <Page Name="TravelCitiesForecast1" Duration="48"/>
    </Flavor>

    <!-- tag53100 -->
    <Flavor Name="53100">
        <Page Name="AffiliateText1" Duration="5" TopSolid="0" BottomSolid="0" LDL="0" RegionSeparator="0"/>
        <Page Name="AffiliateText2" Duration="5" TopSolid="0" BottomSolid="0" LDL="0" RegionSeparator="0"/>
    </Flavor>

</Flavors>